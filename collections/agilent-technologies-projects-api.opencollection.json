{
  "opencollection": "1.0.0",
  "info": {
    "name": "Agilent iLab Operations Cores Projects API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Projects",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Agilent iLab List Projects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ilabsolutions.com/v1/cores/:core_id/projects",
            "params": [
              {
                "name": "core_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the core facility."
              }
            ]
          },
          "docs": "Returns research projects and cost accounts associated with a core facility."
        }
      ]
    }
  ],
  "bundled": true
}