  "info": {
    "_postman_id": "02568825-00e0-448f-b277-0b9f9ab46678",
    "name": "Agilent iLab Operations Cores API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The iLab API enables customers to seamlessly integrate outside applications with iLab's billing and reporting modules. It leverages a RESTful application architecture with HATEOAS (Hypermedia as the Engine of Application State) and OAuth2 for secure access. The API supports integrations with institutional financial systems such as SAP, Oracle/PeopleSoft, Lawson, and Banner, as well as identity management systems and LIMS.\n\nContact Support:\n Email: ilab-support@agilent.com",
      "type": "text/plain"
    }
  }
